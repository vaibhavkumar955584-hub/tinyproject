{
  "name": "@tenderguard/api",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "pnpm --filter @tenderguard/shared build && prisma generate && nest build && ncc build dist/main.js -o dist/bundled && node -e \"const fs=require('fs'); fs.copyFileSync('dist/bundled/index.js','dist/main.js'); const copyEngines=(src)=>{fs.readdirSync(src,{withFileTypes:true}).forEach(e=>{const sp=src+'/'+e.name; if(e.isDirectory()){copyEngines(sp);}else if(e.name.includes('query_engine')||e.name.endsWith('.node')||e.name.endsWith('.prisma')){fs.copyFileSync(sp,'dist/'+e.name); if(!fs.existsSync('dist/client'))fs.mkdirSync('dist/client',{recursive:true}); fs.copyFileSync(sp,'dist/client/'+e.name);}});}; copyEngines('dist/bundled');\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --runInBand --passWithNoTests",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "pnpm exec tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "portal:probe": "tsx scripts/portal-probe.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.3",
    "@tenderguard/shared": "workspace:*",
    "@tiny-fish/sdk": "^0.11.0",
    "@types/sharp": "^0.32.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.5",
    "pdf-parse": "^1.1.1",
    "pg-boss": "^10.3.2",
    "prisma": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.17",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.0.4",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
