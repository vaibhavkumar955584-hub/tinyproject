{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm install && pnpm --filter @tenderguard/shared build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "services": {
    "api": {
      "root": "apps/api",
      "entrypoint": "dist/main.js",
      "buildCommand": "pnpm install && pnpm --filter @tenderguard/shared build && pnpm build",
      "devCommand": "pnpm start:dev"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm install && pnpm --filter @tenderguard/shared build && pnpm build",
      "devCommand": "pnpm dev",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL_INTERNAL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/images/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}

